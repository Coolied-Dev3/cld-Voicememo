# ---- サーバー設定（server/.env にコピーして編集）----
PORT=3002
# HTTPS（certs/server.key, server.crt があるときだけ有効。npm run make-cert で作成）
# リバースプロキシで TLS を終端する場合は不要
HTTPS_PORT=3443

# ---- 公開 URL（リバースプロキシ配下・パスキー用）----
# 公開ドメイン。パスキー(Face ID)の RP ID と、Microsoft 連携のリダイレクト先に使う。
# 未設定ならアクセス時の Host ヘッダから自動判定（サブドメイン直下ならそのままで動く）
RP_ID=
ORIGIN=
# 例: RP_ID=voicememo.example.com / ORIGIN=https://voicememo.example.com

# ---- 認証 ----
# 初回起動時にユーザーが 1 人もいなければ、この ID/パスワードで管理者を作成（ログイン後に必ず変更）
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=voicememo
# セッション有効日数
SESSION_DAYS=30
# トークン暗号化キー（未設定なら data/secret.key に自動生成）
SESSION_SECRET=

# ---- データベース ----
# sqlite: 追加設定なし（data/voicememo.db に保存）
# mysql : 陸上練習管理systemと同じ MySQL に保存（下の DB_* を設定）
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=voicememo

# ---- Claude API（任意）----
# 設定すると「分類・日時抽出」と「Web検索の要約」が Claude で行われる（未設定でもルール分類＋DuckDuckGo/Wikipedia で動作）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Microsoft 365 連携（Graph API・任意）----
# Entra ID にアプリ登録して発行されたアプリケーション (クライアント) ID。設定すると各ユーザーが
# 「Microsoft アカウントで連携」でき、予定は Outlook 予定表、やることは To Do に自動登録される。
MS_CLIENT_ID=
# 「パブリック クライアント」として登録した場合は不要。シークレットを作った場合のみ設定
MS_CLIENT_SECRET=
# organizations（会社/学校アカウント全般） or 自社テナント ID（自社アカウント限定）
MS_TENANT=organizations
# リダイレクト URI（未設定なら https://<公開ドメイン>/api/ms/callback を自動生成。アプリ登録にも同じ値を登録する）
MS_REDIRECT_URI=

# ---- Outlook 連携（Microsoft 連携していないユーザー向けの動作）----
# link: 「Outlook に登録」リンクを表示（既定） / com: この PC の従来 Outlook に自動登録 / off: 連携なし
OUTLOOK_MODE=link
# 会社/学校アカウント: https://outlook.office.com  個人アカウント: https://outlook.live.com
OUTLOOK_WEB_BASE=https://outlook.office.com
